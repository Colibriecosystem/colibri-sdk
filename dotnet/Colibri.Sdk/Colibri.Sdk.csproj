<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Colibri.Sdk</PackageId>
    <Version>0.4.0</Version>
    <Description>Official C# SDK for the Colibri Local API — read the order book, stream trades, and trade from a widget or bot.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>0.4.0 — BREAKING: targets net10.0 (was net8.0); a net8.0 or net9.0 project stays on 0.3.0 or moves to .NET 10. Adds sync-trades, the fills option and the venue-book trade fields.</PackageReleaseNotes>
  </PropertyGroup>

</Project>
